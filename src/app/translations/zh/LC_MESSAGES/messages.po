#: src/app/web/templates/welcome.html:144
msgid "Timing"
msgstr "提醒时间"

#: src/app/web/templates/welcome.html:147
msgid "Before or after"
msgstr "提前或延后"

#: src/app/web/templates/welcome.html:151
