#, python-format
msgid ""
"%(member_name)s was added to the <b>%(group_name)s</b> group tag. Group "
"members are copied to an event when you add the group, so existing events"
" are not updated automatically. This %(count)s active event already has "
"%(group_name)s but does not have %(member_name)s:"
msgid_plural ""
"%(member_name)s was added to the <b>%(group_name)s</b> group tag. Group "
"members are copied to an event when you add the group, so existing events"
" are not updated automatically. These %(count)s active events already "
"have %(group_name)s but do not have %(member_name)s:"
msgstr[0] ""
"%(member_name)s 已添加到 <b>%(group_name)s</b> "
