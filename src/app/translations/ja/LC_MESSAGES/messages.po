#: src/app/web/templates/welcome.html:104
#: src/app/web/templates/welcome.html:118
msgid "Opens — when applications open"
msgstr "受付開始：申込受付開始時"

#: src/app/web/templates/welcome.html:105
msgid "Closes — 1 day before"
msgstr "締切：1日前"

#: src/app/web/templates/welcome.html:106
#: src/app/web/templates/welcome.html:120
#: src/app/web/templates/welcome.html:131
msgid "Results — when results come out"
msgstr "当落発表：発表時"

#: src/app/web/templates/welcome.html:107
msgid "Payment — when payment is due"
msgstr "入金：入金締切時"

#: src/app/web/templates/welcome.html:112
msgid "Balanced"
msgstr "バランス型"

#: src/app/web/templates/welcome.html:114
msgid "Standard"
msgstr "標準"

#: src/app/web/templates/welcome.html:115
msgid "Recommended"
msgstr "おすすめ"

#: src/app/web/templates/welcome.html:119
msgid "Closes — 3 days &amp; 1 day before"
msgstr "締切：3日前 &amp; 1日前"

#: src/app/web/templates/welcome.html:121
msgid "Payment — 1 day before"
msgstr "入金：1日前"

#: src/app/web/templates/welcome.html:126
msgid "More reminders"
msgstr "通知多め"

#: src/app/web/templates/welcome.html:127
msgid "Frequent"
msgstr "こまめ"

#: src/app/web/templates/welcome.html:129
msgid "Opens — 1 day before &amp; when applications open"
msgstr "受付開始：1日前 &amp; 申込受付開始時"

#: src/app/web/templates/welcome.html:130
msgid "Closes — 5, 3 &amp; 1 days before"
msgstr "締切：5日前、3日前 &amp; 1日前"

#: src/app/web/templates/welcome.html:132
msgid "Payment — 3 &amp; 1 days before"
msgstr "入金：3日前 &amp; 1日前"

#: src/app/web/templates/welcome.html:137
msgid ""
"Get one reminder when applications open, results are announced, and "
"payment is due. You also get two reminders before applications close. You"
" can change these below or later in Preferences."
msgstr "受付開始、当落発表、入金締切のときに、それぞれ1回通知します。申込締切前には2回通知します。以下または後から設定画面で変更できます。"

#: src/app/web/templates/welcome.html:148
msgid "Timing"
msgstr "タイミング"

#: src/app/web/templates/welcome.html:149
msgid "Before or after"
msgstr "前／後"

#: src/app/web/templates/welcome.html:150
msgid "Deadline type"
msgstr "締切の種類"

#: src/app/web/templates/welcome.html:152
#, python-brace-format
msgid "Remind me {offset} {direction} {anchor}."
msgstr "{anchor}の{offset}{direction}に通知。"

#: src/app/web/templates/welcome.html:153
msgid "Remove this reminder"
msgstr "このリマインダーを削除"

#: src/app/web/templates/welcome.html:159
msgid "Edit these reminders"
msgstr "リマインダーを編集"

#: src/app/web/templates/welcome.html:160
msgid "Use the menus below to change each reminder."
msgstr "下のメニューから各リマインダーを変更できます。"

#: src/app/web/templates/welcome.html:173
msgid "+ Add a reminder"
msgstr "+ リマインダーを追加"

#: src/app/web/templates/welcome.html:178
msgid "Rules set on one event are used instead of this preset."
msgstr "個別のイベントで設定したルールが、このプリセットより優先されます。"

#: src/app/web/templates/welcome.html:179
msgid "Skip this step"
msgstr "このステップをスキップ"

#: src/app/web/templates/welcome.html:180
msgid "Create preset &amp; continue"
msgstr "プリセットを作成 &amp; 次へ"

#: src/app/web/templates/welcome.html:205
msgid "No reminders yet — add one below."
msgstr "リマインダーはまだありません。下から追加してください。"

#: src/app/web/templates/welcome.html:317
msgid "Confirm your timezone"
msgstr "タイムゾーンを確認"

#: src/app/web/templates/welcome.html:318
msgid ""
"Deadlines always show JST first, then this timezone — so you never have "
"to convert a\n"
"    23:59 JST close in your head."
msgstr "締切時刻はJSTを先に、その後に選択したタイムゾーンで表示します。23:59 JSTの締切も、自分で換算する必要はありません。"

#: src/app/web/templates/welcome.html:322
#, python-format
msgid "Detected <strong>%(tz)s</strong>"
msgstr "<strong>%(tz)s</strong>を検出しました"

#: src/app/web/templates/welcome.html:323
msgid "(auto-detected from your browser)"
msgstr "（ブラウザから自動検出）"

#: src/app/web/templates/welcome.html:343
msgid "Use this timezone"
msgstr "このタイムゾーンを使う"

#: src/app/web/templates/welcome.html:391
#, python-format
msgid ""
"Right now that reads\n"
"  <span class=\"num\">%(tz_preview)s</span> for you."
msgstr ""
"現在の現地時刻は\n"
"  <span class=\"num\">%(tz_preview)s</span>です。"

#: src/app/web/templates/welcome.html:396
msgid "Looks right, continue"
msgstr "問題なければ続ける"

#: src/app/web/templates/welcome.html:404
msgid ""
"Send a test DM now to check that Discord reminders work. If your DMs are "
"blocked, we'll tell you here."
msgstr "テストDMを送って、Discordのリマインダーを受信できるか確認します。DMがブロックされている場合は、ここでお知らせします。"

#: src/app/web/templates/welcome.html:409
msgid "Send test DM"
msgstr "テストDMを送信"

#: src/app/web/templates/welcome.html:418
msgid ""
"✅ <b>Test reminder.</b> If you can read this, test DMs are working. "
"Deadline reminders will look like this and show both JST and your time "
"zone."
msgstr ""
"✅ "
"<b>テストリマインダー。</b>これを読めれば、テストDMは正常に届いています。締切リマインダーもこの形式で、JSTと現地時刻の両方を表示します。"

#: src/app/web/templates/welcome.html:423
msgid ""
"The Discord bot isn't running in this environment\n"
"  (dev mode), so DMs can't be tested here."
msgstr "この環境ではDiscordボットが稼働していないため（開発モード）、DMのテストはできません。"

#: src/app/web/templates/welcome.html:436
msgid "Get your calendar feed"
msgstr "カレンダーフィードを取得"

#: src/app/web/templates/welcome.html:437
msgid ""
"Add this feed to your phone or calendar app to keep your reminder "
"deadlines updated. It gives you a backup to Discord DMs."
msgstr ""
"このフィードをスマートフォンやカレンダーアプリに追加すると、リマインダーを設定した締切が自動更新されます。Discord "
"DMの予備としても使えます。"

#: src/app/web/templates/welcome.html:442
msgid "✓ Your feed link is ready — save it now, it won't be shown again."
msgstr "✓ フィードリンクを作成しました。今すぐ保存してください。この画面には再表示されません。"

#: src/app/web/templates/welcome.html:447
msgid "Add it in Google Calendar, Apple Calendar, or Outlook."
msgstr "Googleカレンダー、Appleカレンダー、またはOutlookに追加してください。"

#: src/app/web/templates/welcome.html:451
msgid "Your feed is active."
msgstr "フィードは有効です。"

#: src/app/web/templates/welcome.html:461
msgid "You're ready. Next, choose which events you plan to attend."
msgstr "準備完了です。次に、参加予定のイベントを選びます。"

#: src/app/web/templates/welcome.html:462
msgid "Continue to my events"
msgstr "イベントの選択へ"

