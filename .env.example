# -- Discord bot ------------------------------------------------
# From https://discord.com/developers/applications -> your app -> Bot -> Token
# Leave EMPTY to run in web-only dev mode (no bot connection).
DISCORD_TOKEN=

# OAuth2 tab -> Client ID / Client Secret (for web login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your test server's ID, for instant slash-command sync during local dev
# (guild-scoped syncs propagate in seconds; global syncs take up to an hour).
# Leave EMPTY in production so commands reach every server the bot is in.
# Get an ID: Discord -> Settings -> Advanced -> Developer Mode -> right-click server -> Copy Server ID
DEV_GUILD_ID=

# -- Local dev only ---------------------------------------------
# Registers the rehearsal harness (/admin/rehearsal), which seeds a canonical
# concert and pulls its reminders forward so the real 60s tick delivers them
# now. Leave EMPTY/false in production: the routes are then absent from the
# app entirely rather than merely guarded, which is the whole safety model --
# a "fire every reminder now" button should not be one misconfiguration away.
# Setup guide (second Discord app, test server, redirect URI): docs/local-dev-bot.md
REHEARSAL_ENABLED=false

# -- Discovery --------------------------------------------------
# Eventernote discovery: a daily sweep of your artists' event pages, DMing
# admins about performances the catalogue does not have. Off by default.
# The first sweep runs within a minute of the restart that enables it, then
# every 24h. Requires tags to carry eventernote_url values.
DISCOVERY_ENABLED=false

# -- Access control ---------------------------------------------
# Comma-separated Discord user IDs allowed to create/edit concerts.
# Everyone else can log in and set their own reminders, but not edit events.
# Optional now that editors can also be granted/revoked live by an admin
# (preferences page or /promote-editor, /demote-editor) -- this whitelist is
# a permanent, restart-required bootstrap/break-glass set, unioned with the
# DB-managed grants rather than replaced by them.
# Get an ID: Discord -> Settings -> Advanced -> Developer Mode -> right-click user -> Copy User ID
EDITOR_WHITELIST=123456789012345678,987654321098765432

# Comma-separated Discord user IDs who can manage editors (promote/demote,
# preferences page or Discord commands). Admins automatically have editor
# rights too. Env-only by design -- edit this file + restart to change it.
ADMIN_WHITELIST=123456789012345678

# -- Web --------------------------------------------------------
# Local dev: http://localhost:8000   Production: https://dekimasen.app
BASE_URL=http://localhost:8000
# Signs the session cookie. Must be set (32+ chars) whenever BASE_URL is
# https, or the app refuses to start.
# Generate a fresh one: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# -- Storage ----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Marker file deploy/backup.sh writes after a successful upload; /healthz and
# the scheduler read it to tell whether backups are still running.
# Only override if the backup marker lives somewhere non-default (tests do).
# Left COMMENTED OUT, unlike the blank entries above: an empty value here would
# override the default with "", which resolves to a directory and makes the
# backup check report "unreadable" forever.
# BACKUP_MARKER_PATH=/home/ubuntu/.dekimasen-backup-ok

# -- Defaults ---------------------------------------------------
# Timezone used for new users and for the "your local time" display.
DEFAULT_TIMEZONE=America/Moncton

# -- Privacy policy contacts ------------------------------------
# Shown on the public /privacy page as the channel for data requests
# (access, correction, deletion). Set either, both, or neither -- the page
# lists whichever are filled in and shows a neutral fallback if none are.
# Left blank here on purpose: these are the operator's real contact
# details, so they belong in the local/server .env, never in the repo.
PRIVACY_CONTACT_DISCORD=
PRIVACY_CONTACT_EMAIL=
