# -- Discord bot ------------------------------------------------
# From https://discord.com/developers/applications -> your app -> Bot -> Token
# Leave EMPTY to run in web-only dev mode (no bot connection).
DISCORD_TOKEN=

# OAuth2 tab -> Client ID / Client Secret (for web login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# -- Access control ---------------------------------------------
# Comma-separated Discord user IDs allowed to create/edit concerts.
# Everyone else can log in and set their own reminders, but not edit events.
# Get an ID: Discord -> Settings -> Advanced -> Developer Mode -> right-click user -> Copy User ID
EDITOR_WHITELIST=123456789012345678,987654321098765432

# -- Web --------------------------------------------------------
# Local dev: http://localhost:8000   Production: https://dekimasen.app
BASE_URL=http://localhost:8000
# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# -- Storage ----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./app.db

# -- Defaults ---------------------------------------------------
# Timezone used for new users and for the "your local time" display.
DEFAULT_TIMEZONE=America/Moncton
