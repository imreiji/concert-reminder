# dekimasen.app behind Cloudflare (orange-cloud proxied).
#
# TLS: Cloudflare Origin CA certificate (15-year validity, no renewal).
#   - Cloudflare dashboard -> SSL/TLS -> Origin Server -> Create Certificate
#   - hosts: dekimasen.app, *.dekimasen.app
#   - save cert  -> /etc/caddy/certs/origin.pem
#   - save key   -> /etc/caddy/certs/origin.key   (chmod 600, owner caddy)
#   - Cloudflare SSL/TLS mode MUST be "Full (strict)"
#
# Browsers never see this cert - they see Cloudflare's edge cert, which
# also satisfies the .app TLD's mandatory-HTTPS (HSTS preload) rule.

dekimasen.app, www.dekimasen.app {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    # Security response headers.
    #
    # Caddy runs directives in its own fixed order, not file order, and
    # `header` sorts ahead of `redir` - so these are set on the www->apex
    # 301 as well as on every proxied response. Nothing here reaches the
    # app, so app code never has to care.
    #
    # X-Frame-Options is the one that earns its keep: the app has no CSRF
    # token by design (SameSite=Lax cookies only). Lax still sends the
    # session cookie on a same-site click, so a framed page that tricks a
    # logged-in editor into clicking a delete/edit button would work.
    # DENY removes the framing half of that attack.
    #
    # Referrer-Policy: the personal calendar-feed token is handed back in a
    # query string - POST /me/calendar-feed redirects to
    # /preferences?feed_token=<raw token> (or /welcome?feed_token=... from
    # the onboarding wizard), and that raw token is the only credential the
    # feed has. Those pages may link out, so same-origin guarantees no
    # Referer carrying that URL ever leaves the site, rather than trusting
    # each browser's default policy. (This mattered more when htmx came from
    # unpkg.com; it is vendored now, but a link-out still leaks a Referer, so
    # the header keeps earning its place.)
    #
    # Deliberately NOT set here:
    #   - Strict-Transport-Security: .app is HSTS-preloaded at the TLD
    #     level, so browsers already refuse plaintext to this domain. An
    #     extra header adds nothing and a bad max-age/includeSubDomains is
    #     painful to walk back. Do not "helpfully" add it.
    #
    # Content-Security-Policy: htmx is now VENDORED (src/app/web/static/
    # htmx.min.js), so the APP itself serves every script it depends on.
    # That is the value here -- before vendoring, a unpkg.com outage broke
    # every interactive surface and a unpkg compromise would have run
    # attacker script in-origin.
    #
    # static.cloudflareinsights.com is the ONE remaining script origin, and
    # it is not ours to remove from here: Cloudflare Web Analytics injects
    # `beacon.min.js` into the HTML AT THE EDGE, after the response has left
    # this server. Nothing in the repo references it, which is exactly why
    # neither the template sweep in tests/test_vendored_assets.py nor a local
    # run against the app could ever have predicted it -- the first shipped
    # CSP blocked it and the console said so on every page. Two ways to
    # change that, both in the Cloudflare dashboard, NOT here:
    #   - don't want the analytics -> turn Web Analytics off, then drop the
    #     host from script-src below;
    #   - want them -> leave as is.
    # It is a defensible thing to allow: cookieless (so it needs no consent
    # banner, which is why it was turned on), and on the automatic-injection
    # path Cloudflare stamps the tag with its own `integrity` hash, so the
    # host is allowed but a swapped payload still would not execute.
    #
    # connect-src deliberately does NOT name cloudflareinsights.com. This
    # zone is orange-cloud proxied, so the beacon POSTs its data to
    # https://dekimasen.app/cdn-cgi/rum -- same origin, already covered by
    # 'self'. Only MANUAL embedding on an unproxied site talks to
    # cloudflareinsights.com directly. If this zone is ever grey-clouded,
    # that changes and the console will say so.
    #
    # Two relaxations, both currently load-bearing, neither permanent:
    #   - script-src 'unsafe-inline': ~15 templates carry inline <script>
    #     blocks, including base.html's pre-paint theme stamp (which MUST be
    #     inline -- an external file would race first paint and flash the
    #     wrong theme). Tightening means a per-request nonce threaded through
    #     every block; worth doing, not worth guessing at.
    #   - style-src 'unsafe-inline': inline style="" attributes across ~10
    #     templates (preferences.html alone has 31).
    # Even with both, this policy still stops the injected-<script src> and
    # exfiltrate-to-attacker-host classes, which is what actually matters
    # given there is no CSRF token by design (SameSite=Lax only).
    #
    # img-src names cdn.discordapp.com because SessionUser.avatar_url points
    # there (web/auth.py) -- it is the ONLY third-party origin left.
    # frame-ancestors 'none' restates X-Frame-Options for browsers that
    # honour CSP over the older header; keep both while old clients exist.
    # connect-src 'self' bounds htmx's XHRs. form-action 'self' is safe:
    # every <form action> in the templates is a same-origin path, and the
    # Discord OAuth handoff is a redirect, not a form post.
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    }

    @www host www.dekimasen.app
    redir @www https://dekimasen.app{uri} permanent

    reverse_proxy 127.0.0.1:8000
}
